# --- Server -------------------------------------------------------------
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

MONGO_URL=mongodb://localhost:27017/pulseboard


JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# Sign-in, sign-up and code requests allowed per IP per minute.
AUTH_RATE_LIMIT=10


NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1


S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=


# Email. BREVO_API_KEY (HTTP API) works on hosts that block SMTP, like Render's free
# tier. Gmail SMTP is a fallback for local development. MAIL_FROM must be a sender
# you've verified in Brevo, e.g. "PulseBoard <you@gmail.com>" or just the address.
BREVO_API_KEY=
GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_FROM=

CONTACT_EMAIL=

# Rebuild the public demo every N hours (needs `npm run demo:reset` once first).
DEMO_RESET_HOURS=
